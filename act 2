public class Main {

    public static void main(String[] args) {

        // Create Aly's and Ben's wallets
        CampusWallet aly = new CampusWallet("Aly", 100);
        CampusWallet ben = new CampusWallet("Ben");

        // Test 1: Starting balances
        System.out.println("Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Test 2: Aly transfers 35 credits to Ben
        boolean transfer1 = aly.transferTo(ben, 35);

        System.out.println(transfer1 + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Test 3: Aly tries to transfer 70 credits to Ben
        boolean transfer2 = aly.transferTo(ben, 70);

        System.out.println(transfer2 + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Test 4: Aly tries to transfer 10 credits to herself
        boolean transfer3 = aly.transferTo(aly, 10);

        System.out.println(transfer3 + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Test 5: Ben deposits 15 credits
        boolean deposit1 = ben.deposit(15);

        System.out.println(deposit1 + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Test 6: Aly transfers all remaining 65 credits to Ben
        boolean transfer4 = aly.transferTo(ben, 65);

        System.out.println(transfer4 + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Additional Test 1: Zero-credit transfer
        boolean transfer5 = aly.transferTo(ben, 0);

        System.out.println("Zero-credit transfer: " + transfer5
                + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());

        // Additional Test 2: Transfer to null
        boolean transfer6 = aly.transferTo(null, 10);

        System.out.println("Transfer to null: " + transfer6
                + "; Aly: " + aly.getBalance()
                + ", Ben: " + ben.getBalance());
    }
}


public class Main {

    public static void main(String[] args) {

        // Create Mia's and Luis's accounts
        PrintAccount mia = new PrintAccount("Mia", 10);
        PrintAccount luis = new PrintAccount("Luis", -4);

        // Test 1: Starting credits
        System.out.println("Mia: " + mia.getCredits()
                + ", Luis: " + luis.getCredits());

        // Test 2: Mia prints 4 pages
        boolean result1 = mia.printPages(4);

        System.out.println(result1 + "; Mia: " + mia.getCredits());

        // Test 3: Mia tries to print 7 pages
        boolean result2 = mia.printPages(7);

        System.out.println(result2 + "; Mia: " + mia.getCredits());

        // Test 4: Mia tries to add -3 credits
        boolean result3 = mia.addCredits(-3);

        System.out.println(result3 + "; Mia: " + mia.getCredits());

        // Test 5: Mia adds 4 credits
        boolean result4 = mia.addCredits(4);

        System.out.println(result4 + "; Mia: " + mia.getCredits()
                + ", Luis: " + luis.getCredits());
    }
}

